    {
      "type": "piechart",
      "id": 13,
      "title": "Playback failures by reason",
      "description": "age_restricted and bot_check need YouTube cookies, forbidden/rate_limited usually mean YouTube is blocking the server IP, transient means it worked when retried",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (reason) (round(increase(botchini_music_track_failure_count{job=\"$job\"}[$__range])))",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "pieType": "donut",
