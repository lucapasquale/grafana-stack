            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 27,
      "type": "stat",
      "title": "Avg peak viewers",
      "description": "Average of each stream's peak viewer count over the selected range",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "round(sum(increase(botchini_screens_room_peak_viewers_sum{job=\"$job\"}[$__range])) / sum(increase(botchini_screens_room_peak_viewers_count{job=\"$job\"}[$__range])), 0.1)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
