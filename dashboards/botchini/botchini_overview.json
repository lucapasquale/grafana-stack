      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "queryType": "range",
          "expr": "{service=\"botchini\"} | json | metadata_event=~\"screen_share_live|screen_viewer_joined\" | line_format `{{ if eq .metadata_event \"screen_share_live\" }}\ud83d\udd34 {{ .metadata_screen_owner_name }} started streaming \"{{ .metadata_screen_title }}\"{{ else }}\ud83d\udc40 Someone started watching {{ .metadata_screen_owner_name }}'s stream ({{ .metadata_viewer_count }} watching){{ end }}`"
