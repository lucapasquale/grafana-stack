      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "Streamers broadcasting at each moment, derived from room start/stop counters"
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Streams started and viewers joining",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(increase(botchini_screens_room_live_count{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "Streams started"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(increase(botchini_screens_viewer_join_count{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "Viewers started watching"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 25,
      "type": "logs",
      "title": "Stream events",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "queryType": "range",
          "expr": "{service=\"botchini\"} | json | metadata_event=~\"screen_share_live|screen_viewer_joined\" | line_format `{{ if eq .metadata_event \"screen_share_live\" }}\ud83d\udd34 {{ .metadata_screen_owner_name }} started streaming \"{{ .metadata_screen_title }}\"{{ else }}\ud83d\udc40 Someone started watching {{ .metadata_screen_owner_name }}'s stream ({{ .metadata_viewer_count }} watching){{ end }}`"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      }
    },
    {
      "id": 29,
      "type": "row",
      "title": "Stream quality: what to watch",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": []
    },
    {
      "id": 30,
      "type": "stat",
      "title": "Viewer packet loss",
      "description": "Video packets lost on the way to viewers, averaged over the range. Above 1% the picture starts breaking up: look at the Stream quality dashboard for which source it is, and the round trip of the people sharing.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(increase(botchini_screens_viewer_video_packet_loss_percent_sum{job=\"$job\"}[$__range])) / sum(increase(botchini_screens_viewer_video_packet_loss_percent_count{job=\"$job\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 31,
      "type": "stat",
      "title": "Viewer fps",
      "description": "Frames per second viewers' browsers decode, averaged. Screens send up to 60, so a low number means the sharer or the network can't keep up.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 22
