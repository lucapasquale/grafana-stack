      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(increase(botchini_screens_viewer_video_freezes_sum{job=\"$job\"}[$__range])) / (sum(increase(botchini_screens_viewer_video_freezes_count{job=\"$job\"}[$__range])) * 10 / 3600)",
          "instant": true,
          "range": false
