              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 33,
      "type": "stat",
      "title": "Stereo audio",
      "description": "Share of viewers' audio that's stereo. Pages ask for stereo since the audio fix, so less than all of it means old tabs or a browser that ignores it.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(increase(botchini_screens_viewer_audio_reports_count{job=\"$job\", stereo=\"true\"}[$__range])) / sum(increase(botchini_screens_viewer_audio_reports_count{job=\"$job\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
