      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(increase(botchini_screens_viewer_video_fps_sum{job=\"$job\"}[$__range])) / sum(increase(botchini_screens_viewer_video_fps_count{job=\"$job\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "green",
                "value": 26
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Freezes per viewer hour",
      "description": "Times the picture froze for viewers, per hour of watching.",
