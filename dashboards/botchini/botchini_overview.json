          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "logs",
      "id": 14,
      "title": "Recent playback failures",
      "description": "Diagnosed by re-running yt-dlp/streamlink after the failure",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "refId": "A",
          "expr": "{service=\"botchini\"} |= \"track_failed\" | json | line_format \"{{.metadata_reason}} \u00b7 {{.metadata_track_title}} \u00b7 {{.metadata_error}}\""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
