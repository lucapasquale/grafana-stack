    {
      "id": 36,
      "type": "timeseries",
      "title": "Viewer packet loss and fps",
      "description": "How screens come through to viewers, by source: packet loss on the left, frames per second on the right.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (source)(rate(botchini_screens_viewer_video_packet_loss_percent_sum{job=\"$job\"}[$__rate_interval])) / sum by (source)(rate(botchini_screens_viewer_video_packet_loss_percent_count{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{source}} loss"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (source)(rate(botchini_screens_viewer_video_fps_sum{job=\"$job\"}[$__rate_interval])) / sum by (source)(rate(botchini_screens_viewer_video_fps_count{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{source}} fps"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": true
          },
          "decimals": 1,
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* fps"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 37,
      "type": "timeseries",
      "title": "Sharers held back, and why",
      "description": "Reports from sharing browsers by why they lowered the quality: none, cpu, bandwidth or other.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
