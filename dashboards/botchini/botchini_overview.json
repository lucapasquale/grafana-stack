      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": "label_values(botchini_prom_ex_prom_ex_status_info, job)",
        "refresh": 1,
        "current": {},
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "title": "Botchini dashboards",
      "type": "dashboards",
