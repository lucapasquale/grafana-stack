      "panel-13": {
        "kind": "Panel",
        "spec": {
          "id": 13,
          "title": "Players over time",
          "description": "Sessões simultâneas reportadas por A2S. Lacuna = servidor fora do ar (o exporter só publica enquanto o servidor responde). Slots do servidor: a2s_server_max_players (16 no enshrouded_server.json).",
