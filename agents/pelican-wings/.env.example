# Copy to .env (git-ignored) and fill in. The Cloudflare Access service token is
# the same one the stack's own APIs use; create it under
# Cloudflare Zero Trust -> Access -> Service Auth -> Service Tokens.

# Host label stamped on every log stream and metric (used by the dashboards).
ALLOY_HOSTNAME=pelican-lxc

# Host docker group id — getent group docker | cut -d: -f3
DOCKER_GID=991

# A2S query address of a game server (host:port of its QUERY port, e.g.
# Enshrouded 15637 UDP — not the game port). Polled by the a2s-exporter
# sidecar, which turns it into a2s_server_players / a2s_server_max_players.
A2S_TARGET=192.168.1.115:15637

# Cloudflare Access service token (Keep the .access suffix on the client id.)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
